<?php
/**
 * /login/admin/assignments.php — Product assignment management
 *
 * Access  : role = 'admin' OR role = 'owner'
 * Purpose : Create private quotation links (secret links) for customer clients.
 *           Admin/owner selects a product, sets a profit margin, and generates a
 *           unique token-based URL that the client can open to see only the final
 *           price — never the raw FOB/CIF cost.
 *
 * Security notes:
 *  - Only SHA-256 hash of the token is stored in the DB (never the plain token).
 *  - final_price is calculated server-side; the frontend preview is informational only.
 *  - product_id is validated against DB; price data comes from DB, never from POST.
 *  - CSRF token required on every state-changing request.
 *  - Prepared statements used for all queries.
 */

// ── Security headers ─────────────────────────────────────────
header('X-Frame-Options: DENY');
header('X-Content-Type-Options: nosniff');
header('Referrer-Policy: strict-origin-when-cross-origin');
header('Cache-Control: no-store, no-cache, must-revalidate');
header('Content-Type: text/html; charset=utf-8');

// ── Bootstrap ────────────────────────────────────────────────
session_set_cookie_params([
    'lifetime' => 0,
    'path'     => '/',
    'secure'   => false,
    'httponly' => true,
    'samesite' => 'Lax',
]);
session_start();

require_once __DIR__ . '/../includes/auth.php';
require_once __DIR__ . '/../includes/csrf.php';
require_once __DIR__ . '/../includes/lang.php';
require_once __DIR__ . '/../config/db.php';
require_once __DIR__ . '/../includes/tabs.php';
require_once __DIR__ . '/../includes/audit.php';

requireAuth();
initLang();
requireRole(['admin', 'owner']);   // supplier and user must NOT access this

$pdo    = getDB();
$userId = (int) $_SESSION['user_id'];
$orgId  = (int) ($_SESSION['org_id'] ?? 0);
$lang   = currentLang();

// ── Helpers ───────────────────────────────────────────────────

/**
 * Build the absolute public quote URL for a plain token.
 */
function buildQuoteLink(string $plainToken): string
{
    $scheme = (!empty($_SERVER['HTTPS']) && $_SERVER['HTTPS'] !== 'off') ? 'https' : 'http';
    $host   = $_SERVER['HTTP_HOST'] ?? 'localhost';
    return $scheme . '://' . $host . '/login/quote.php?t=' . rawurlencode($plainToken);
}

// ── POST handler ──────────────────────────────────────────────
if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    csrfValidate();

    $action = $_POST['action'] ?? '';

    if ($action === 'create_assignment') {

        $errors = [];

        // ── 1. Validate product_id ───────────────────────────
        $productId = (int) ($_POST['product_id'] ?? 0);
        if ($productId <= 0) {
            $errors[] = t('asgn_err_product_required');
        }

        // ── 2. Validate customer name ────────────────────────
        $customerName = mb_substr(trim($_POST['customer_name'] ?? ''), 0, 200);
        if ($customerName === '') {
            $errors[] = t('asgn_err_customer_required');
        }

        // ── 3. Validate price base type (whitelist) ──────────
        $baseType = strtolower(trim($_POST['price_base_type'] ?? ''));
        if (!in_array($baseType, ['fob', 'cif'], true)) {
            $errors[] = t('asgn_err_base_invalid');
        }

        // ── 4. Validate profit percentage ────────────────────
        //    Accept integer or decimal 0–999; coerce to float for DB.
        $profitRaw = trim($_POST['profit_percentage'] ?? '');
        if (!is_numeric($profitRaw)) {
            $errors[] = t('asgn_err_profit_invalid');
            $profitPct = 0.0;
        } else {
            $profitPct = (float) $profitRaw;
            if ($profitPct < 0 || $profitPct > 999) {
                $errors[] = t('asgn_err_profit_invalid');
            }
        }

        // ── 5. Load product from DB (authoritative source) ───
        $product = null;
        if ($productId > 0 && empty($errors)) {
            $stmt = $pdo->prepare(
                'SELECT id, product_name, supplier_product_code,
                        admin_product_code, internal_product_code, price_fob, price_cif
                   FROM supplier_products
                  WHERE id = ? AND active = 1
                  LIMIT 1'
            );
            $stmt->execute([$productId]);
            $product = $stmt->fetch();
            if (!$product) {
                $errors[] = t('asgn_err_product_invalid');
            }
        }

        // ── 6. Verify chosen base price exists ───────────────
        $baseAmount = null;
        if ($product && empty($errors)) {
            if ($baseType === 'fob') {
                if ($product['price_fob'] === null || $product['price_fob'] === '') {
                    $errors[] = t('asgn_err_no_fob');
                } else {
                    $baseAmount = (float) $product['price_fob'];
                }
            } else { // cif
                if ($product['price_cif'] === null || $product['price_cif'] === '') {
                    $errors[] = t('asgn_err_no_cif');
                } else {
                    $baseAmount = (float) $product['price_cif'];
                }
            }
        }

        if (!empty($errors)) {
            $_SESSION['asgn_errors']  = $errors;
            $_SESSION['asgn_form']    = $_POST; // repopulate form
            header('Location: /login/admin/assignments.php');
            exit;
        }

        // ── 7. Server-side price calculation ─────────────────
        $finalPrice = round($baseAmount * (1 + $profitPct / 100), 2);

        // ── 8. Generate secure token ──────────────────────────
        //    plain_token = 32 random bytes -> 64-char hex string
        //    stored_hash = SHA-256 of plain_token (64-char hex)
        $plainToken = bin2hex(random_bytes(32));
        $tokenHash  = hash('sha256', $plainToken);

        // ── 9. Set expiry: now + 7 days ───────────────────────
        $validFrom = date('Y-m-d H:i:s');
        $expiresAt = date('Y-m-d H:i:s', strtotime('+7 days'));

        // ── 10. Insert into DB ────────────────────────────────
        try {
            $ins = $pdo->prepare(
                'INSERT INTO product_assignments
                    (product_id, org_id, assigned_customer_name,
                     token_hash, status, price_base_type,
                     price_base_amount, profit_percentage, final_price,
                     valid_from, expires_at, created_by_user_id)
                 VALUES (?, ?, ?, ?, "active", ?, ?, ?, ?, ?, ?, ?)'
            );
            $ins->execute([
                $productId,
                $orgId,
                $customerName,
                $tokenHash,
                $baseType,
                $baseAmount,
                $profitPct,
                $finalPrice,
                $validFrom,
                $expiresAt,
                $userId,
            ]);

            $newAssignmentId = (int) $pdo->lastInsertId();
            auditLog('assignment_created', 'info', $newAssignmentId, $userId, [
                'product_id'    => $productId,
                'product_name'  => $product['product_name'],
                'customer_name' => $customerName,
                'base_type'     => $baseType,
                'profit_pct'    => $profitPct,
                'final_price'   => $finalPrice,
                'expires_at'    => $expiresAt,
            ]);

        } catch (\PDOException $e) {
            error_log('assignments.php insert failed: ' . $e->getMessage());
            $_SESSION['asgn_errors'] = [t('asgn_err_save')];
            $_SESSION['asgn_form']   = $_POST;
            header('Location: /login/admin/assignments.php');
            exit;
        }

        // ── 11. PRG: Store plain token in session for one load ─
        $_SESSION['asgn_new_link']         = buildQuoteLink($plainToken);
        $_SESSION['asgn_new_customer']     = $customerName;
        $_SESSION['asgn_new_product_name'] = $product['product_name'];
        $_SESSION['asgn_new_expires']      = $expiresAt;
        $_SESSION['asgn_new_price']        = $finalPrice;
        $_SESSION['asgn_feedback']         = t('asgn_success');
        $_SESSION['asgn_feedback_type']    = 'success';

        header('Location: /login/admin/assignments.php');
        exit;

    } elseif ($action === 'revoke_assignment') {

        // ── Revoke: set status='revoked' only if currently 'active' ──
        $assignmentId = (int) ($_POST['assignment_id'] ?? 0);
        if ($assignmentId <= 0) {
            $_SESSION['asgn_feedback']      = t('asgn_err_assignment_invalid');
            $_SESSION['asgn_feedback_type'] = 'error';
            header('Location: /login/admin/assignments.php');
            exit;
        }

        try {
            $upd = $pdo->prepare(
                "UPDATE product_assignments
                    SET status = 'revoked',
                        revoked_at = NOW(),
                        revoked_by_user_id = ?,
                        updated_at = NOW()
                  WHERE id = ? AND status = 'active'"
            );
            $upd->execute([$userId, $assignmentId]);

            if ($upd->rowCount() > 0) {
                auditLog('assignment_revoked', 'info', $assignmentId, $userId);
                $_SESSION['asgn_feedback']      = t('asgn_revoked_success');
                $_SESSION['asgn_feedback_type'] = 'success';
            } else {
                $_SESSION['asgn_feedback']      = t('asgn_err_revoke_failed');
                $_SESSION['asgn_feedback_type'] = 'error';
            }
        } catch (\PDOException $e) {
            error_log('assignments.php revoke failed: ' . $e->getMessage());
            $_SESSION['asgn_feedback']      = t('asgn_err_revoke_failed');
            $_SESSION['asgn_feedback_type'] = 'error';
        }

        header('Location: /login/admin/assignments.php');
        exit;

    } elseif ($action === 'delete_assignment') {

        // ── Soft-delete: set status='deleted', hide from list ──
        $assignmentId = (int) ($_POST['assignment_id'] ?? 0);
        if ($assignmentId <= 0) {
            $_SESSION['asgn_feedback']      = t('asgn_err_assignment_invalid');
            $_SESSION['asgn_feedback_type'] = 'error';
            header('Location: /login/admin/assignments.php');
            exit;
        }

        try {
            $upd = $pdo->prepare(
                "UPDATE product_assignments
                    SET status = 'deleted',
                        deleted_at = NOW(),
                        deleted_by_user_id = ?,
                        updated_at = NOW()
                  WHERE id = ? AND status IN ('active','expired','revoked')"
            );
            $upd->execute([$userId, $assignmentId]);

            if ($upd->rowCount() > 0) {
                auditLog('assignment_deleted', 'info', $assignmentId, $userId);
                $_SESSION['asgn_feedback']      = t('asgn_deleted_success');
                $_SESSION['asgn_feedback_type'] = 'success';
            } else {
                $_SESSION['asgn_feedback']      = t('asgn_err_delete_failed');
                $_SESSION['asgn_feedback_type'] = 'error';
            }
        } catch (\PDOException $e) {
            error_log('assignments.php delete failed: ' . $e->getMessage());
            $_SESSION['asgn_feedback']      = t('asgn_err_delete_failed');
            $_SESSION['asgn_feedback_type'] = 'error';
        }

        header('Location: /login/admin/assignments.php');
        exit;

    } elseif ($action === 'regen_link') {

        // ── Regen: clone assignment with new token + optional new customer name ──
        $assignmentId    = (int) ($_POST['assignment_id'] ?? 0);
        $newCustomerName = mb_substr(trim($_POST['customer_name'] ?? ''), 0, 200);

        if ($assignmentId <= 0) {
            $_SESSION['asgn_feedback']      = t('asgn_err_assignment_invalid');
            $_SESSION['asgn_feedback_type'] = 'error';
            header('Location: /login/admin/assignments.php');
            exit;
        }
        if ($newCustomerName === '') {
            $_SESSION['asgn_feedback']      = t('asgn_err_customer_required');
            $_SESSION['asgn_feedback_type'] = 'error';
            header('Location: /login/admin/assignments.php');
            exit;
        }

        try {
            // Load parent assignment (must not be deleted)
            $sel = $pdo->prepare(
                "SELECT id, product_id, org_id, price_base_type,
                        price_base_amount, profit_percentage, final_price,
                        p.product_name
                   FROM product_assignments a
                   JOIN supplier_products p ON p.id = a.product_id
                  WHERE a.id = ? AND a.status != 'deleted'
                  LIMIT 1"
            );
            $sel->execute([$assignmentId]);
            $parent = $sel->fetch();

            if (!$parent) {
                $_SESSION['asgn_feedback']      = t('asgn_err_assignment_invalid');
                $_SESSION['asgn_feedback_type'] = 'error';
                header('Location: /login/admin/assignments.php');
                exit;
            }

            // Generate new token
            $plainToken = bin2hex(random_bytes(32));
            $tokenHash  = hash('sha256', $plainToken);
            $validFrom  = date('Y-m-d H:i:s');
            $expiresAt  = date('Y-m-d H:i:s', strtotime('+7 days'));

            // Insert new assignment (child), linked to parent
            $ins = $pdo->prepare(
                'INSERT INTO product_assignments
                    (product_id, org_id, assigned_customer_name,
                     token_hash, status, price_base_type,
                     price_base_amount, profit_percentage, final_price,
                     valid_from, expires_at, created_by_user_id, parent_assignment_id)
                 VALUES (?, ?, ?, ?, "active", ?, ?, ?, ?, ?, ?, ?, ?)'
            );
            $ins->execute([
                $parent['product_id'],
                $parent['org_id'],
                $newCustomerName,
                $tokenHash,
                $parent['price_base_type'],
                $parent['price_base_amount'],
                $parent['profit_percentage'],
                $parent['final_price'],
                $validFrom,
                $expiresAt,
                $userId,
                $assignmentId,
            ]);

            $newAssignmentId = (int) $pdo->lastInsertId();
            auditLog('assignment_link_regenerated', 'info', $newAssignmentId, $userId, [
                'parent_id'    => $assignmentId,
                'customer'     => $newCustomerName,
                'final_price'  => $parent['final_price'],
                'expires_at'   => $expiresAt,
            ]);

            // Flash new link (same pattern as create_assignment)
            $_SESSION['asgn_new_link']         = buildQuoteLink($plainToken);
            $_SESSION['asgn_new_customer']     = $newCustomerName;
            $_SESSION['asgn_new_product_name'] = $parent['product_name'];
            $_SESSION['asgn_new_expires']      = $expiresAt;
            $_SESSION['asgn_new_price']        = $parent['final_price'];
            $_SESSION['asgn_feedback']         = t('asgn_regen_success');
            $_SESSION['asgn_feedback_type']    = 'success';

        } catch (\PDOException $e) {
            error_log('assignments.php regen_link failed: ' . $e->getMessage());
            $_SESSION['asgn_feedback']      = t('asgn_err_save');
            $_SESSION['asgn_feedback_type'] = 'error';
        }

        header('Location: /login/admin/assignments.php');
        exit;
    }
}

// ── Flash messages ────────────────────────────────────────────
$feedback     = $_SESSION['asgn_feedback']      ?? null;
$feedbackType = $_SESSION['asgn_feedback_type'] ?? 'info';
$formErrors   = $_SESSION['asgn_errors']        ?? [];
$formRepop    = $_SESSION['asgn_form']          ?? [];
$newLink      = $_SESSION['asgn_new_link']      ?? null;
$newCustomer  = $_SESSION['asgn_new_customer']  ?? null;
$newProdName  = $_SESSION['asgn_new_product_name'] ?? null;
$newExpires   = $_SESSION['asgn_new_expires']   ?? null;
$newPrice     = $_SESSION['asgn_new_price']     ?? null;

unset(
    $_SESSION['asgn_feedback'],
    $_SESSION['asgn_feedback_type'],
    $_SESSION['asgn_errors'],
    $_SESSION['asgn_form'],
    $_SESSION['asgn_new_link'],
    $_SESSION['asgn_new_customer'],
    $_SESSION['asgn_new_product_name'],
    $_SESSION['asgn_new_expires'],
    $_SESSION['asgn_new_price']
);

// ── Load all active products for the selector ─────────────────
// Include price_fob / price_cif for JS preview (safe: admin-only page)
$allProducts = $pdo->query(
    'SELECT p.id,
            p.product_name,
            p.supplier_product_code,
            p.admin_product_code,
            p.internal_product_code,
            p.price_fob,
            p.price_cif,
            u.username     AS supplier_username,
            u.company_name AS supplier_company,
            o.name         AS org_name
       FROM supplier_products p
       JOIN users u ON u.id = p.supplier_id
       LEFT JOIN org_members om  ON om.user_id = u.id AND om.is_active = 1
       LEFT JOIN organizations o ON o.id = om.org_id
      WHERE p.active = 1
      ORDER BY p.product_name ASC, p.supplier_product_code ASC'
)->fetchAll();

// ── Load recent assignments (last 30, exclude deleted) ──────────
$recentAssignments = $pdo->query(
    "SELECT a.id,
            a.product_id,
            a.assigned_customer_name,
            a.price_base_type,
            a.profit_percentage,
            a.final_price,
            a.status,
            a.expires_at,
            a.view_count,
            a.created_at,
            a.revoked_at,
            a.parent_assignment_id,
            p.product_name,
            p.supplier_product_code,
            p.internal_product_code,
            u.username AS creator_username
       FROM product_assignments a
       JOIN supplier_products p ON p.id = a.product_id
       JOIN users u ON u.id = a.created_by_user_id
      WHERE a.status != 'deleted'
      ORDER BY a.created_at DESC
      LIMIT 30"
)->fetchAll();

// ── View helpers ──────────────────────────────────────────────
$esc      = fn($v): string => htmlspecialchars((string)($v ?? ''), ENT_QUOTES, 'UTF-8');
$username = htmlspecialchars($_SESSION['username'] ?? '', ENT_QUOTES, 'UTF-8');
$initial  = strtoupper(substr($username, 0, 1));
$orgName  = htmlspecialchars($_SESSION['org_name'] ?? '', ENT_QUOTES, 'UTF-8');
$csrf     = htmlspecialchars(csrfToken(), ENT_QUOTES, 'UTF-8');

$fmtPrice = fn($v) => ($v !== null && $v !== '')
    ? '$ ' . number_format((float) $v, 2)
    : '—';

// Repopulate helpers
$repop = function(string $key, string $default = '') use ($formRepop): string {
    return htmlspecialchars($formRepop[$key] ?? $default, ENT_QUOTES, 'UTF-8');
};
$repopIs = function(string $key, string $value) use ($formRepop): bool {
    return ($formRepop[$key] ?? '') === $value;
};

// Status badge class
$statusClass = [
    'active'  => 'status-badge--active',
    'expired' => 'status-badge--inactive',
    'revoked' => 'status-badge--inactive',
    'deleted' => 'status-badge--inactive',
];

?>
<!DOCTYPE html>
<html lang="<?= $lang ?>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta http-equiv="Cache-Control" content="no-store">
    <title><?= $esc(t('asgn_page_title')) ?></title>
    <link rel="stylesheet" href="/login/css/style.css?v=12">
    <style>
        /* ── Assignment-specific styles ── */
        .asgn-price-preview {
            background: #f0f7ff;
            border: 1px solid #b8d6f5;
            border-radius: 8px;
            padding: 12px 16px;
            margin-top: 8px;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .asgn-price-preview .preview-value {
            font-size: 1.4rem;
            font-weight: 700;
            color: var(--color-accent, #0071e3);
        }
        .asgn-price-preview .preview-note {
            font-size: 0.82rem;
            color: #666;
        }
        .profit-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 6px;
        }
        .profit-btn {
            padding: 6px 14px;
            border: 1.5px solid #d0d0d5;
            border-radius: 20px;
            background: #fff;
            cursor: pointer;
            font-size: 0.9rem;
            transition: border-color 0.15s, background 0.15s;
        }
        .profit-btn:hover {
            border-color: var(--color-accent, #0071e3);
        }
        .profit-btn.selected {
            background: var(--color-accent, #0071e3);
            border-color: var(--color-accent, #0071e3);
            color: #fff;
            font-weight: 600;
        }
        .base-btn-group {
            display: flex;
            gap: 10px;
            margin-top: 6px;
        }
        .base-btn {
            flex: 1;
            padding: 10px;
            border: 1.5px solid #d0d0d5;
            border-radius: 8px;
            background: #fff;
            cursor: pointer;
            font-size: 0.95rem;
            font-weight: 500;
            text-align: center;
            transition: border-color 0.15s, background 0.15s;
        }
        .base-btn:hover { border-color: var(--color-accent, #0071e3); }
        .base-btn.selected {
            background: var(--color-accent, #0071e3);
            border-color: var(--color-accent, #0071e3);
            color: #fff;
        }
        .link-result-box {
            background: #f0fff4;
            border: 1.5px solid #68d391;
            border-radius: 10px;
            padding: 18px 20px;
            margin-bottom: 24px;
        }
        .link-result-box h3 {
            margin: 0 0 10px;
            font-size: 1rem;
            color: #276749;
        }
        .link-copy-row {
            display: flex;
            gap: 8px;
            align-items: stretch;
        }
        .link-copy-input {
            flex: 1;
            padding: 8px 12px;
            border: 1px solid #b2dfdb;
            border-radius: 6px;
            font-size: 0.85rem;
            color: #2d3748;
            background: #fff;
            font-family: monospace;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .link-meta {
            margin-top: 10px;
            font-size: 0.85rem;
            color: #444;
            display: flex;
            flex-wrap: wrap;
            gap: 14px;
        }
        .link-meta span { display: flex; align-items: center; gap: 4px; }
        .asgn-table-wrap { overflow-x: auto; }
        .free-profit-row {
            margin-top: 8px;
            display: none;
            align-items: center;
            gap: 8px;
        }
        .free-profit-row.visible { display: flex; }
        .free-profit-input {
            width: 90px;
            padding: 6px 10px;
            border: 1.5px solid #d0d0d5;
            border-radius: 6px;
            font-size: 0.95rem;
        }
        .free-profit-suffix { font-size: 0.9rem; color: #555; }
        /* ── Assignment action buttons ── */
        .asgn-actions { display:flex; gap:5px; flex-wrap:wrap; }
        .btn-asgn-action {
            padding: 4px 10px;
            font-size: 0.78rem;
            font-weight: 500;
            border-radius: 6px;
            border: 1.5px solid transparent;
            cursor: pointer;
            white-space: nowrap;
            transition: background 0.15s, color 0.15s;
        }
        .btn-asgn-action--danger {
            background: #fff0f0;
            border-color: #f5c2c2;
            color: #c0392b;
        }
        .btn-asgn-action--danger:hover {
            background: #fde8e8;
            border-color: #e74c3c;
        }
        .btn-asgn-action--primary {
            background: #eaf4ff;
            border-color: #b8d6f5;
            color: #0071e3;
        }
        .btn-asgn-action--primary:hover {
            background: #d6ebff;
            border-color: #0071e3;
        }
        /* ── Regen modal ── */
        .asgn-modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.45);
            z-index: 1000;
            align-items: center;
            justify-content: center;
        }
        .asgn-modal-overlay.open { display: flex; }
        .asgn-modal {
            background: #fff;
            border-radius: 14px;
            padding: 28px 28px 22px;
            max-width: 440px;
            width: 92%;
            box-shadow: 0 8px 40px rgba(0,0,0,0.18);
        }
        .asgn-modal h3 {
            margin: 0 0 16px;
            font-size: 1.05rem;
            color: #1a1a2e;
        }
        .asgn-modal .form-label {
            font-size: 0.88rem;
            margin-bottom: 4px;
        }
        .asgn-modal input[type=text] {
            width: 100%;
            padding: 8px 12px;
            border: 1.5px solid #d0d0d5;
            border-radius: 7px;
