# Storage configuration
# APP_STORAGE_ROOT  — absolute path to the upload root (outside webroot recommended)
# STORAGE_DRIVER    — 'local' (default). Future: 's3'
# STORAGE_PUBLIC_BASE — web path prefix for the secure file-serving endpoint
APP_STORAGE_ROOT=C:/MAMP/app_storage/webdesign
STORAGE_DRIVER=local
STORAGE_PUBLIC_BASE=/login/storage-file

# ── Future S3/R2 (not yet implemented) ────────────────────────
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT=

# ── Database ──────────────────────────────────────────────────
# These are loaded from config/db.php directly; shown here for reference only.
# DB_HOST=localhost
# DB_NAME=webdesign
# DB_USER=root
# DB_PASS=

# ── Mail ─────────────────────────────────────────────────────
# Real config lives in config/mail.php (gitignored).
# See config/mail.example.php for the template.
