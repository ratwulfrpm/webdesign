# Application environment
# Controls logging verbosity and security behaviour.
# Valid values: dev | staging | prod
# Default (if not set): prod  — the safe default; never exposes debug info.
#
# How to set (Apache / MAMP .htaccess):
#   SetEnv APP_ENV dev
# How to set (php.ini / MAMP PHP settings):
#   env[APP_ENV] = dev
#
# DEV:     detailed logs, temp passwords visible in UI (after reset), full email body in mail.log
# STAGING: same security posture as prod but may show extra diagnostics
# PROD:    no secrets in logs, no temp passwords in UI, errors are generic
APP_ENV=dev

# Storage configuration
# APP_STORAGE_ROOT  — absolute path to the upload root (outside webroot recommended)
# STORAGE_DRIVER    — 'local' (default). Future: 's3'
# STORAGE_PUBLIC_BASE — web path prefix for the secure file-serving endpoint
APP_STORAGE_ROOT=C:/MAMP/app_storage/webdesign
STORAGE_DRIVER=local
STORAGE_PUBLIC_BASE=/login/storage-file

# ── Future S3/R2 (not yet implemented) ────────────────────────
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT=

# ── Database ──────────────────────────────────────────────────
# These are loaded from config/db.php directly; shown here for reference only.
# DB_HOST=localhost
# DB_NAME=webdesign
# DB_USER=root
# DB_PASS=

# ── Mail ─────────────────────────────────────────────────────
# Real config lives in config/mail.php (gitignored).
# See config/mail.example.php for the template.
