<?php
/**
 * /login/quote.php — Public product quotation view (no authentication required)
 *
 * URL : /login/quote.php?t={plain_64hex_token}
 *
 * Security design:
 *  - No user session or authentication required.
 *  - Receives a plain token via GET ?t=
 *  - Hashes the token server-side and looks up the matching row in product_assignments.
 *  - NEVER accepts product_id or assignment_id from the URL (anti-IDOR).
 *  - On any invalid/expired/revoked/missing token: shows a generic error message.
 *    No information is revealed about whether the token or product exists.
 *  - FOB/CIF raw prices and all internal admin data are never shown.
 *  - All output is escaped (XSS prevention).
 *  - No SQL concatenation — all queries use prepared statements.
 *
 * Token flow:
 *  plain_token (URL)  →  hash('sha256', plain_token)  →  lookup token_hash in DB
 */

// ── Security headers ─────────────────────────────────────────
header('X-Frame-Options: DENY');
header('X-Content-Type-Options: nosniff');
header('Referrer-Policy: no-referrer');
header('Cache-Control: no-store, no-cache, must-revalidate');
header('Content-Type: text/html; charset=utf-8');

// ── Bootstrap (no auth required) ─────────────────────────────
require_once __DIR__ . '/config/db.php';
require_once __DIR__ . '/includes/lang.php';
require_once __DIR__ . '/includes/audit.php';

// Minimal language support (no session needed; fall back to 'en')
// We call initLang() only if a session is active; otherwise use a safe default.
$lang = 'en';
if (session_status() === PHP_SESSION_NONE) {
    // Start a lightweight read-only session for language preference only
    session_set_cookie_params([
        'lifetime' => 0,
        'path'     => '/',
        'secure'   => false,
        'httponly' => true,
        'samesite' => 'Lax',
    ]);
    session_start();
}
initLang();
$lang = currentLang();

// ── Generic error response helper ────────────────────────────
// Called whenever the token is invalid, expired, revoked, or absent.
// Shows NOTHING that could reveal internal state.
function showExpiredPage(string $lang): void
{
    // Load strings for the error page (inline — minimal, no framework needed)
    $msgs = [
        'en' => [
            'title'   => 'Link unavailable',
            'heading' => 'This link is not available or has expired.',
            'detail'  => 'The quotation you requested is no longer accessible. Please contact the person who sent you this link.',
        ],
        'es' => [
            'title'   => 'Enlace no disponible',
            'heading' => 'Este enlace no está disponible o ha expirado.',
            'detail'  => 'La cotización que solicitó ya no es accesible. Contacte a la persona que le envió este enlace.',
        ],
        'zh' => [
            'title'   => '链接不可用',
            'heading' => '此链接不可用或已过期。',
            'detail'  => '您请求的报价已无法访问。请联系向您发送此链接的人。',
        ],
    ];
    $m = $msgs[$lang] ?? $msgs['en'];
    $esc = fn($v) => htmlspecialchars((string) $v, ENT_QUOTES, 'UTF-8');
    echo '<!DOCTYPE html><html lang="' . $esc($lang) . '"><head>'
        . '<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">'
        . '<title>' . $esc($m['title']) . '</title>'
        . '<link rel="stylesheet" href="/login/css/style.css?v=12">'
        . '</head><body>'
        . '<div class="page-content" style="max-width:520px;margin:80px auto;text-align:center;">'
        . '<div class="card" style="padding:40px 32px;">'
        . '<svg width="48" height="48" viewBox="0 0 24 24" fill="none" style="margin-bottom:16px;" aria-hidden="true">'
        . '<circle cx="12" cy="12" r="10" stroke="#d1d1d6" stroke-width="1.5"/>'
        . '<path d="M12 8v5M12 16h.01" stroke="#8e8e93" stroke-width="1.5" stroke-linecap="round"/>'
        . '</svg>'
        . '<h1 style="font-size:1.2rem;margin-bottom:12px;">' . $esc($m['heading']) . '</h1>'
        . '<p style="color:#666;font-size:0.9rem;">' . $esc($m['detail']) . '</p>'
        . '</div></div></body></html>';
    exit;
}

// ── Extract and validate token format ────────────────────────
$rawToken = trim($_GET['t'] ?? '');
$_auditIp = _auditClientIp();

// Rate-limit: block IPs that have made >= 20 invalid-token attempts in the last 10 minutes.
if (auditIsRateLimited('quote_invalid_token', $_auditIp, 20, 600)) {
    auditLog('quote_rate_limited', 'warning', null, null, ['ip' => $_auditIp]);
    http_response_code(429);
    showExpiredPage($lang);
}

// Token must be exactly 64 lowercase hex chars (bin2hex(random_bytes(32)))
if (!preg_match('/^[0-9a-f]{64}$/', $rawToken)) {
    auditLog('quote_invalid_token', 'warning', null, null, ['reason' => 'bad_format']);
    showExpiredPage($lang);
}

// ── Hash the plain token and look up in DB ────────────────────
$tokenHash = hash('sha256', $rawToken);
$pdo = getDB();

$stmt = $pdo->prepare(
    'SELECT a.id,
            a.product_id,
            a.assigned_customer_name,
            a.status,
            a.final_price,
            a.valid_from,
            a.expires_at,
            a.view_count,
            p.product_name,
            p.technical_description,
            p.internal_product_code,
            p.active AS product_active
       FROM product_assignments a
       JOIN supplier_products p ON p.id = a.product_id
      WHERE a.token_hash = ?
      LIMIT 1'
);
$stmt->execute([$tokenHash]);
$assignment = $stmt->fetch();

// ── Validate assignment ───────────────────────────────────────
if (!$assignment) {
    auditLog('quote_invalid_token', 'warning', null, null, ['reason' => 'not_found']);
    showExpiredPage($lang);
}

// Status check (DB status field)
if ($assignment['status'] !== 'active') {
    auditLog('quote_not_active', 'warning', (int) $assignment['id'], null, ['status' => $assignment['status']]);
    showExpiredPage($lang);
}

// Expiry check (server-side, never trust client)
if (strtotime($assignment['expires_at']) < time()) {
    // Optionally mark as expired in DB (best-effort, non-blocking)
    try {
        $pdo->prepare(
            "UPDATE product_assignments SET status = 'expired', updated_at = NOW()
              WHERE id = ? AND status = 'active'"
        )->execute([$assignment['id']]);
    } catch (\PDOException $e) {
        error_log('quote.php expire update failed: ' . $e->getMessage());
    }
    auditLog('quote_expired', 'info', (int) $assignment['id']);
    showExpiredPage($lang);
}

// Product must still be active
if (!(int) $assignment['product_active']) {
    auditLog('quote_product_inactive', 'warning', (int) $assignment['id']);
    showExpiredPage($lang);
}

// ── Record access (non-blocking, best-effort) ─────────────────
try {
    $now = date('Y-m-d H:i:s');
    $pdo->prepare(
        'UPDATE product_assignments
            SET view_count      = view_count + 1,
                last_viewed_at  = ?,
                viewed_at       = COALESCE(viewed_at, ?),
                updated_at      = ?
          WHERE id = ?'
    )->execute([$now, $now, $now, $assignment['id']]);
    auditLog('quote_accessed', 'info', (int) $assignment['id'], null,
        ['view_count' => (int) $assignment['view_count'] + 1]);
} catch (\PDOException $e) {
    error_log('quote.php view_count update failed: ' . $e->getMessage());
}

// ── Load product images (safe — keyed by slot, no raw paths in URL) ──
$imgStmt = $pdo->prepare(
    'SELECT image_slot, file_path
       FROM supplier_product_images
      WHERE product_id = ?'
);
$imgStmt->execute([$assignment['product_id']]);
$images = [];
foreach ($imgStmt->fetchAll() as $img) {
    $images[$img['image_slot']] = $img['file_path'];
}

// ── Load keywords ─────────────────────────────────────────────
$kwStmt = $pdo->prepare(
    'SELECT keyword FROM product_keywords WHERE product_id = ? ORDER BY keyword ASC'
);
$kwStmt->execute([$assignment['product_id']]);
$keywords = $kwStmt->fetchAll(PDO::FETCH_COLUMN);

// ── Slot labels (not role-restricted strings — purely display) ─
$slotLabels = [
    'front'  => t('img_slot_front'),
    'back'   => t('img_slot_back'),
    'left'   => t('img_slot_left'),
    'right'  => t('img_slot_right'),
    'aerial' => t('img_slot_aerial'),
    'bottom' => t('img_slot_bottom'),
];

// ── View helpers ──────────────────────────────────────────────
$esc      = fn($v): string => htmlspecialchars((string)($v ?? ''), ENT_QUOTES, 'UTF-8');
$fmtDate  = fn($v) => date('d/m/Y', strtotime($v));
$fmtPrice = fn($v) => '$ ' . number_format((float) $v, 2);

?>
<!DOCTYPE html>
<html lang="<?= $lang ?>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta http-equiv="Cache-Control" content="no-store">
    <!-- No product name in title — avoids leaking product info in browser history/shared tabs -->
    <title><?= $esc(t('quote_page_title')) ?></title>
    <link rel="stylesheet" href="/login/css/style.css?v=12">
    <style>
        /* ── Quote-page-specific styles ── */
        body { background: #f5f5f7; }
        .quote-header {
            background: #fff;
            border-bottom: 1px solid #e5e5ea;
            padding: 20px 32px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 0;
        }
        .quote-brand {
            font-size: 1.1rem;
            font-weight: 600;
            color: #1d1d1f;
        }
        .quote-validity {
            font-size: 0.85rem;
            color: #555;
        }
        .quote-wrap {
            max-width: 820px;
            margin: 32px auto;
            padding: 0 16px 48px;
        }
        .quote-card {
            background: #fff;
            border-radius: 14px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.07);
            overflow: hidden;
        }
        .quote-card-header {
            padding: 28px 32px 20px;
            border-bottom: 1px solid #f0f0f3;
        }
        .quote-product-name {
            font-size: 1.5rem;
            font-weight: 700;
            color: #1d1d1f;
            margin: 0 0 6px;
            line-height: 1.3;
        }
        .quote-product-code {
            font-size: 0.85rem;
            color: #888;
            font-family: monospace;
        }
        .quote-price-box {
            display: flex;
            align-items: baseline;
            gap: 8px;
            margin: 20px 32px;
            padding: 20px 24px;
            background: #f0f7ff;
            border: 1.5px solid #b8d6f5;
            border-radius: 12px;
        }
        .quote-price-label {
            font-size: 0.9rem;
            color: #555;
            font-weight: 500;
        }
        .quote-price-value {
            font-size: 2rem;
            font-weight: 800;
            color: #0071e3;
        }
        .quote-section {
            padding: 20px 32px;
            border-top: 1px solid #f0f0f3;
        }
        .quote-section-title {
            font-size: 0.9rem;
            font-weight: 600;
            color: #6e6e73;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            margin: 0 0 12px;
        }
        .quote-desc {
            font-size: 0.95rem;
            color: #333;
            line-height: 1.65;
            white-space: pre-line;
        }
        .quote-gallery {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
            gap: 12px;
        }
        .quote-gallery-slot {
            border-radius: 8px;
            overflow: hidden;
            border: 1px solid #e5e5ea;
            cursor: zoom-in;
        }
        .quote-gallery-slot img {
            width: 100%;
            height: 160px;
            object-fit: cover;
            display: block;
        }
        .quote-gallery-caption {
            padding: 6px 8px;
            font-size: 0.78rem;
            color: #666;
            text-align: center;
            background: #fafafa;
        }
        .quote-front-img {
            width: 100%;
            max-height: 360px;
            object-fit: contain;
            border-radius: 8px;
            border: 1px solid #e5e5ea;
            cursor: zoom-in;
            margin-bottom: 16px;
            display: block;
        }
        .quote-keyword-tags { display: flex; flex-wrap: wrap; gap: 6px; }
        .quote-keyword-chip {
            padding: 3px 12px;
            border-radius: 20px;
            background: #f0f0f5;
            font-size: 0.82rem;
            color: #3a3a4a;
        }
        .quote-meta-box {
            margin: 0 32px 24px;
            padding: 14px 20px;
            background: #fafafa;
            border: 1px solid #e5e5ea;
            border-radius: 10px;
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            font-size: 0.88rem;
            color: #444;
        }
        .quote-meta-box .meta-item strong { display: block; color: #1d1d1f; font-size: 0.8rem; margin-bottom: 2px; }
        .quote-footer-note {
            text-align: center;
            padding: 20px;
            font-size: 0.8rem;
            color: #aaa;
            border-top: 1px solid #f0f0f3;
        }
        /* Lightbox */
        .quote-lightbox {
            display: none;
            position: fixed; inset: 0;
            background: rgba(0,0,0,0.88);
            z-index: 9999;
            align-items: center;
            justify-content: center;
        }
        .quote-lightbox.active { display: flex; }
        .quote-lightbox img { max-width: 90vw; max-height: 88vh; border-radius: 6px; }
        .quote-lightbox-close {
            position: absolute; top: 18px; right: 22px;
            background: none; border: none; color: #fff;
            font-size: 1.8rem; cursor: pointer; line-height: 1;
        }
        @media (max-width: 600px) {
            .quote-header { padding: 14px 16px; }
            .quote-price-box { margin: 16px; }
            .quote-section  { padding: 16px; }
            .quote-meta-box { margin: 0 16px 16px; }
            .quote-product-name { font-size: 1.2rem; }
        }
    </style>
</head>
<body>

    <!-- ── Header ──────────────────────────────────────────── -->
    <header class="quote-header">
        <div class="quote-brand"><?= $esc(t('quote_page_title')) ?></div>
        <div class="quote-validity">
            <?= $esc(t('quote_valid_until')) ?>:
            <strong><?= $esc($fmtDate($assignment['expires_at'])) ?></strong>
        </div>
    </header>

    <main class="quote-wrap">
        <div class="quote-card">

            <!-- ── Product name & code ──────────────────── -->
            <div class="quote-card-header">
                <h1 class="quote-product-name"><?= $esc($assignment['product_name']) ?></h1>
                <?php if (!empty($assignment['internal_product_code'])): ?>
                <div class="quote-product-code">
                    <?= $esc(t('quote_product_code_label')) ?>:
                    <?= $esc($assignment['internal_product_code']) ?>
                </div>
                <?php endif; ?>
            </div>

            <!-- ── Final client price (ONLY this — never FOB/CIF) ── -->
            <div class="quote-price-box">
                <span class="quote-price-label"><?= $esc(t('quote_price_label')) ?></span>
                <span class="quote-price-value"><?= $esc($fmtPrice($assignment['final_price'])) ?></span>
            </div>

            <!-- ── Quotation metadata ───────────────────── -->
            <div class="quote-meta-box">
                <div class="meta-item">
                    <strong><?= $esc(t('quote_client_label')) ?></strong>
                    <?= $esc($assignment['assigned_customer_name']) ?>
                </div>
                <div class="meta-item">
                    <strong><?= $esc(t('quote_expires_label')) ?></strong>
                    <?= $esc($fmtDate($assignment['expires_at'])) ?>
                </div>
            </div>

            <!-- ── Description / Technical sheet ──────── -->
            <?php if (!empty($assignment['technical_description'])): ?>
            <div class="quote-section">
                <div class="quote-section-title"><?= $esc(t('quote_description_label')) ?></div>
                <div class="quote-desc">
                    <?php
                    // Escape the description then restore safe newlines.
                    // No HTML is rendered from DB — fully escaped (XSS safe).
                    echo nl2br($esc($assignment['technical_description']));
                    ?>
                </div>
            </div>
            <?php endif; ?>

            <!-- ── Image gallery ────────────────────────── -->
            <?php if (!empty($images)): ?>
            <div class="quote-section">
                <div class="quote-section-title"><?= $esc(t('quote_gallery_label')) ?></div>

                <!-- Front view — featured / large -->
                <?php if (isset($images['front'])): ?>
                <img src="/login/<?= $esc($images['front']) ?>"
                     alt="<?= $esc($slotLabels['front']) ?>"
                     class="quote-front-img"
                     onclick="openLightbox(this.src, this.alt)">
                <?php endif; ?>

                <!-- Other views grid -->
                <?php
                $optSlots = ['back', 'left', 'right', 'aerial', 'bottom'];
                $hasOpt = false;
                foreach ($optSlots as $s) { if (isset($images[$s])) { $hasOpt = true; break; } }
                ?>
                <?php if ($hasOpt): ?>
                <div class="quote-gallery">
                    <?php foreach ($optSlots as $slot): ?>
                        <?php if (isset($images[$slot])): ?>
                        <div class="quote-gallery-slot"
                             onclick="openLightbox('/login/<?= $esc($images[$slot]) ?>', '<?= $esc($slotLabels[$slot] ?? $slot) ?>')">
                            <img src="/login/<?= $esc($images[$slot]) ?>"
                                 alt="<?= $esc($slotLabels[$slot] ?? $slot) ?>"
                                 loading="lazy">
                            <div class="quote-gallery-caption">
                                <?= $esc($slotLabels[$slot] ?? $slot) ?>
                            </div>
                        </div>
                        <?php endif; ?>
                    <?php endforeach; ?>
                </div>
                <?php endif; ?>

            </div>
            <?php endif; ?>

            <!-- ── Keywords ──────────────────────────────── -->
            <?php if (!empty($keywords)): ?>
            <div class="quote-section">
                <div class="quote-section-title"><?= $esc(t('quote_keywords_label')) ?></div>
                <div class="quote-keyword-tags">
                    <?php foreach ($keywords as $kw): ?>
                    <span class="quote-keyword-chip"><?= $esc($kw) ?></span>
                    <?php endforeach; ?>
                </div>
            </div>
            <?php endif; ?>

            <!-- ── Footer note ──────────────────────────── -->
            <div class="quote-footer-note">
                <?= $esc(sprintf(t('quote_footer_note'), date('d/m/Y', strtotime($assignment['expires_at'])))) ?>
            </div>

        </div><!-- /quote-card -->
    </main>

    <!-- Lightbox overlay -->
    <div class="quote-lightbox" id="lightbox"
         role="dialog" aria-modal="true"
         onclick="closeLightbox()">
        <button type="button" class="quote-lightbox-close" onclick="closeLightbox()" aria-label="Close">&#x2715;</button>
        <img src="" alt="" id="lightboxImg">
    </div>

    <script>
    function openLightbox(src, alt) {
        const el = document.getElementById('lightbox');
        const img = document.getElementById('lightboxImg');
        img.src = src;
        img.alt = alt || '';
        el.classList.add('active');
        document.body.style.overflow = 'hidden';
    }
    function closeLightbox() {
        document.getElementById('lightbox').classList.remove('active');
        document.body.style.overflow = '';
        document.getElementById('lightboxImg').src = '';
    }
    document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeLightbox(); });
    </script>

</body>
</html>
