# Credentials — never commit real passwords
config/mail.php

# Environment config (contains real secrets/paths)
.env

# Uploaded files (runtime data, never commit)
uploads/contracts/**
uploads/products/**

# Keep upload tree placeholders/config only
!uploads/.htaccess
!uploads/contracts/
!uploads/contracts/.gitkeep
!uploads/products/
!uploads/products/.gitkeep

# External storage root (when APP_STORAGE_ROOT is inside the repo)
app_storage/

# Dev logs
logs/

# OS / editor
.DS_Store
Thumbs.db
*.swp
.vscode/
