# ── apple-login root .htaccess ───────────────────────────────
# Requires mod_rewrite and mod_headers (enabled by default in MAMP)

Options -Indexes -MultiViews

# ── Character set ─────────────────────────────────────────────
AddDefaultCharset UTF-8

# ── Prevent direct access to PHP includes & config ────────────
<FilesMatch "^(db|auth|csrf)\.php$">
    Require all denied
</FilesMatch>

# ── Block dotfiles ────────────────────────────────────────────
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# ── Basic HTTP security headers ───────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Frame-Options          "DENY"
    Header always set X-Content-Type-Options   "nosniff"
    Header always set Referrer-Policy          "strict-origin-when-cross-origin"
    Header always set X-XSS-Protection         "1; mode=block"
</IfModule>

# ── Disable server signature ──────────────────────────────────
ServerSignature Off

# ── Optional: redirect www → non-www (not needed for localhost) ─
# RewriteEngine On
# RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
# RewriteRule ^ http://%1%{REQUEST_URI} [R=301,L]

# ── Progressive Router — Clean URL support ────────────────────
#
# Routes requests for non-existent paths through router.php.
# This enables clean URLs like /login/admin/products alongside
# the existing legacy URLs like /login/admin/products.php.
#
# Rules:
#  1. If the requested path IS an existing file → serve it directly.
#     (legacy .php files are served without going through the router)
#  2. If the requested path IS an existing directory → serve it directly.
#  3. If the path contains /api/ → skip (API has its own front controller).
#  4. Everything else → dispatch through router.php.
#
# This means:
#  /login/admin/products.php → served directly (legacy, unchanged)
#  /login/admin/products     → rewritten to router.php (clean URL)
#  /login/api/v1/products    → NOT rewritten (API handled separately)
#
# Safe for MAMP/Apache local development. Requires mod_rewrite.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI}      !/api/ [NC]
    RewriteRule ^                   router.php [QSA,L]
</IfModule>
